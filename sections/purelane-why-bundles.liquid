{% comment %}
  Purelane Why Bundles Beat Buying Single Section
{% endcomment %}

<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | default: 'The smarter way to shop' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Why bundles beat buying single' }}</h2>
      </div>
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">
              {%- if block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
              {%- endif -%}
            </span>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG HTML"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Save up to 45%", "text": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "title": "One flat price", "text": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "title": "Curated by experts", "text": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "title": "Free shipping always", "text": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
