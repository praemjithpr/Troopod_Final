{% comment %}
  Purelane Customer Reviews Rail Section
  Section 05 from prototype specification
{% endcomment %}

<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg">
        <span class="st">{{ section.settings.stars | default: '★★★★★' }}</span>
        <b>{{ section.settings.rating_score | default: '4.8' }}</b> {{ section.settings.reviews_count_text | default: 'from 8,000+ reviews' }}
      </span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count_text | default: '12 lakh+' }}</b> homes</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      <!-- First Loop of Reviews -->
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">{{ block.settings.stars | default: '★★★★★' }}</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            {%- if block.settings.product_tag != blank -%}
              <span>· {{ block.settings.product_tag }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}

      <!-- Duplicate Loop for Infinite Seamless Marquee -->
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">{{ block.settings.stars | default: '★★★★★' }}</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            {%- if block.settings.product_tag != blank -%}
              <span>· {{ block.settings.product_tag }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "stars",
      "label": "Star Rating Display",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews Sub-text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_count_text",
      "label": "Homes Counter Text",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars Rating",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Body Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Purchased Product Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
