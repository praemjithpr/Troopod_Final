{% comment %}
  Purelane Bundle Categories Section
{% endcomment %}

<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bundle categories' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Find the right bundle for you' }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat rv {{ block.settings.delay_class }}" href="{{ block.settings.url | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            <span class="pimg {{ block.settings.pimg_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.title }}"></span>
          </span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.subtext }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "text",
          "id": "pimg_class",
          "label": "Image CSS Class",
          "default": "p-kitchen"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "delay_class",
          "label": "Delay Class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kitchen bundle", "subtext": "Grease, dishes & more", "pimg_class": "p-kitchen", "url": "#combos" } },
        { "type": "category", "settings": { "title": "Bathroom bundle", "subtext": "Deep clean & disinfect", "pimg_class": "p-toilet", "url": "#combos", "delay_class": "rv-d1" } },
        { "type": "category", "settings": { "title": "Laundry bundle", "subtext": "Softer, fresher wash", "pimg_class": "p-laundry", "url": "#combos", "delay_class": "rv-d2" } },
        { "type": "category", "settings": { "title": "Hard water bundle", "subtext": "Melt away limescale", "pimg_class": "p-tap", "url": "#combos", "delay_class": "rv-d3" } }
      ]
    }
  ]
}
{% endschema %}
