        {
          "type": "text",
          "id": "delay_class",
          "label": "Reveal Delay Class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_label": "Starter",
            "item_qty": "2",
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "feature1": "Pick any two products",
            "feature2": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_best_value": true,
