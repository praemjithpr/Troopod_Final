{% comment %}
  Purelane Bundles / Tier Picker Section
  Section 04 from prototype specification
{% endcomment %}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: 'Build your bundle' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'One box. Every room.' }}</h2>
        <p class="lede" style="margin:0 auto">
          {{ section.settings.subheading | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' }}
        </p>
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.is_best_value %}best{% endif %} rv {{ block.settings.delay_class }}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag_label != blank -%}
            <span class="tag">{{ block.settings.tag_label }}</span>
          {%- endif -%}

          <div class="tierpix {% if block.settings.is_five_items %}five{% endif %}" aria-hidden="true">
            <span class="pimg p-kitchen" role="img" aria-label="Purelane kitchen cleaner"></span>
            <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner"></span>
            <span class="pimg p-dish" role="img" aria-label="Purelane dishwash gel"></span>
            {%- if block.settings.is_five_items -%}
              <span class="pimg p-toilet" role="img" aria-label="Purelane toilet cleaner"></span>
              <span class="pimg p-laundry" role="img" aria-label="Purelane laundry detergent"></span>
            {%- endif -%}
          </div>

          <div class="qty">
            {{ block.settings.item_qty }}
            <small>Products</small>
          </div>

          <div class="price">
            {{ block.settings.price }}
            {%- if block.settings.compare_price != blank -%}
              <s>{{ block.settings.compare_price }}</s>
            {%- endif -%}
          </div>

          <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>

          <ul>
            {%- if block.settings.feature1 != blank -%}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                {{ block.settings.feature1 }}
              </li>
            {%- endif -%}
            {%- if block.settings.feature2 != blank -%}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                {{ block.settings.feature2 }}
              </li>
            {%- endif -%}
            {%- if block.settings.feature3 != blank -%}
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                {{ block.settings.feature3 }}
              </li>
            {%- endif -%}
          </ul>

          <a class="btn {% if block.settings.is_best_value %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.btn_url | default: '#shop' }}">
            {{ block.settings.btn_label | default: 'Build this box' }}
            {%- if block.settings.is_best_value -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
