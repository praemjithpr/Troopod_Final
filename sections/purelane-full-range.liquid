{% comment %}
  Purelane Full Range Section
{% endcomment %}

<section class="sec" id="range" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker | default: 'The full range' }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading | default: 'Every room, one shelf' }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">
          {{ section.settings.text | default: 'Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.' }}
        </p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          <span class="pimg p-floor" role="img" aria-label="Floor cleaner"></span>
          <span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span>
          <span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span>
          <span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span>
          <span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span>
          <span class="pimg p-dish" role="img" aria-label="Dishwash gel"></span>
          <span class="pimg p-metal" role="img" aria-label="Copper cleaner"></span>
          <span class="pimg p-wm" role="img" aria-label="Washing machine cleaner"></span>
          <span class="pimg p-handwash" role="img" aria-label="Liquid handwash"></span>
          <span class="pimg p-eraser" role="img" aria-label="Magic eraser"></span>
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Full Range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    }
  ],
  "presets": [
    {
      "name": "Purelane Full Range"
    }
  ]
}
{% endschema %}
