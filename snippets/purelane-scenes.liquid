{% comment %}
  Purelane Global Background Scenes Component
  Renders SVG water caustics, dynamic scene gradients, bubble particles, and vignette.
{% endcomment %}

<div class="scenes" id="scenes" data-d="1">
  <div class="scene s1 on"></div>
  <div class="scene s2"></div>
  <div class="scene s3"></div>
  <div class="scene s4"></div>

  <div class="water" id="water">
    <div class="wl wl-a">
      <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="cg1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
            <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
            <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
            <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
            <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
          </linearGradient>
          <filter id="wf1" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/>
            <feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/>
          </filter>
        </defs>
        <g filter="url(#wf1)">
          <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238 Q1694 248 1804 250 Q2024 236 Q2134 201 2244 214" stroke="url(#cg1)" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
          <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269 Q2003 243 2172 259 Q2342 237 2512 245" stroke="url(#cg1)" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
          <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694 Q1761 756 1886 724 Q2010 739 2135 742" stroke="url(#cg1)" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
          <path d="M51 390 Q154 420 258 394 Q361 414 465 411 Q568 376 672 400 Q776 357 879 376 Q983 384 1086 371 Q1190 419 1293 393" stroke="url(#cg1)" stroke-width="4.7" fill="none" opacity="0.42" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <div class="wl wl-c">
      <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="sg1" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/>
            <stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/>
            <stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <g>
          <polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#sg1)" opacity="0.26"/>
          <polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#sg1)" opacity="0.41"/>
          <polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#sg1)" opacity="0.31"/>
          <polygon points="1366,-80 1520,-80 1898,1180 1690,1180" fill="url(#sg1)" opacity="0.28"/>
        </g>
      </svg>
    </div>

    <div class="bub">
      <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
      <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
      <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
      <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
      <span style="--x:11.1%;--s:7.9px;--dur:20.4s;--dly:10.8s;--drift:-40px"></span>
    </div>
  </div>

  <div class="vig"></div>
</div>
